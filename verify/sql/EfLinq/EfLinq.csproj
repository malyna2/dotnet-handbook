<Project Sdk="Microsoft.NET.Sdk">
  <!-- Prints the SQL EF Core 10 generates for the LINQ in Chapter 7's "SQL Queries in EF Core LINQ"
       table, and runs it, on both engines in ../docker-compose.yml. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- SqlClient's transitive System.Security.Cryptography.Pkcs carries advisories with no patched
         version in the local feed. A local tool against development containers: keep them as warnings. -->
    <WarningsNotAsErrors>NU1902;NU1903</WarningsNotAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization> <!-- SqlClient refuses to open a connection in invariant mode -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" VersionOverride="10.0.3" />
  </ItemGroup>
</Project>
